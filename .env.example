# Copy to .env — NEVER commit real secrets

# ─── William / Jarvis agent ─────────────────────────────────────────────────

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787

# Storage (Mac mini internal — run ./scripts/migrate-storage.sh once)
# JARVIS_DATA_DIR=/Users/willy/Library/Application Support/Jarvis/data
# JARVIS_STATE_ROOT=/Users/willy/Library/Application Support/Jarvis
# JARVIS_LOGS_DIR=/Users/willy/Library/Logs/Jarvis
# JARVIS_WORKSPACE_DIR=/Users/willy/jarvis-core

# LLM / integrations (optional — William stays free-first without these)
CURSOR_API_KEY=

# Execution (local-first: Ollama + parallel terminal; Cursor only for big builds)
JARVIS_FREE_FIRST=true
JARVIS_WORKER_PARALLEL=6
JARVIS_TERMINAL_PARALLEL=4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Public webhooks (Cloudflare tunnel, etc.)
PUBLIC_WEBHOOK_URL=

# Optional Redis (docker compose --profile redis)
REDIS_URL=redis://127.0.0.1:6379

# Vigil / remote (optional)
VIGIL_API_KEY=

# ─── Free AI provider gateway (one backend powers every device) ─────────────
# Keys are found automatically by Key Scout in: env, ~/.config/jarvis/keys.env (preferred,
# written by POST /api/providers/keys), this .env, ~/.config/<provider>/api_key, macOS Keychain
# (service "jarvis-<provider>"). Leave blank here and use keys.env to keep secrets out of the repo.
# free_cloud_first (default) | local_first | local_only
JARVIS_GATEWAY_MODE=free_cloud_first
# Coding: Gemini 2.5 Flash (1M context) https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Coding: Codestral / Mistral  https://console.mistral.ai/api-keys  (+ https://console.mistral.ai/codestral)
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
# Speed + Whisper STT: Groq  https://console.groq.com/keys
GROQ_API_KEY=
# Speech / embeddings / 3D Spaces: Hugging Face  https://huggingface.co/settings/tokens
HF_TOKEN=
# Personality + memory routing: OpenRouter  https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Vector memory (optional — local SQLite vectors always work)
PINECONE_API_KEY=
JARVIS_PINECONE_INDEX_HOST=
JARVIS_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Global personality prepended to chat/reason calls (OpenRouter first)
JARVIS_PERSONALITY_PROMPT=
JARVIS_SEMANTIC_MEMORY_ENABLED=true
# 3D: HF Space for image→mesh (needs .venv/bin/pip install gradio_client)
JARVIS_HF_MESH_SPACE=stabilityai/TripoSR
# App icons for every built/shipped app
JARVIS_APP_ICONS_ENABLED=true

# ─── LAN fleet (same WiFi — Mac Mini control plane) ─────────────────────────
# For peer workers on MacBook/PC, bind LAN and set a shared token:
# JARVIS_HOST=0.0.0.0
JARVIS_FLEET_TOKEN=
JARVIS_FLEET_HEARTBEAT_TIMEOUT_SECONDS=90
JARVIS_FLEET_MINI_NAME=Mac Mini
JARVIS_FLEET_MINI_LAN_HOST=127.0.0.1
JARVIS_FLEET_MACBOOK_NAME=MacBook
JARVIS_FLEET_MACBOOK_LAN_HOST=
JARVIS_FLEET_PC_NAME=Windows PC
JARVIS_FLEET_PC_LAN_HOST=
JARVIS_FLEET_PC_MAC=
JARVIS_FLEET_WOL_BROADCAST=255.255.255.255
JARVIS_FLEET_WOL_PORT=9
