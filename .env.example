# Copy to .env — NEVER commit real secrets

# ─── William / Jarvis agent ─────────────────────────────────────────────────

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787

# Storage (Mac mini internal — run ./scripts/migrate-storage.sh once)
# JARVIS_DATA_DIR=/Users/willy/Library/Application Support/Jarvis/data
# JARVIS_STATE_ROOT=/Users/willy/Library/Application Support/Jarvis
# JARVIS_LOGS_DIR=/Users/willy/Library/Logs/Jarvis
# JARVIS_WORKSPACE_DIR=/Users/willy/jarvis-core

# LLM / integrations (optional — William stays free-first without these)
CURSOR_API_KEY=

# Execution (local-first: Ollama + parallel terminal; Cursor only for big builds)
JARVIS_FREE_FIRST=true
JARVIS_WORKER_PARALLEL=6
JARVIS_TERMINAL_PARALLEL=4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Public webhooks (Cloudflare tunnel, etc.)
PUBLIC_WEBHOOK_URL=

# Optional Redis (docker compose --profile redis)
REDIS_URL=redis://127.0.0.1:6379

# Vigil / remote (optional)
VIGIL_API_KEY=

# ─── LAN fleet (same WiFi — Mac Mini control plane) ─────────────────────────
# For peer workers on MacBook/PC, bind LAN and set a shared token:
# JARVIS_HOST=0.0.0.0
JARVIS_FLEET_TOKEN=
JARVIS_FLEET_HEARTBEAT_TIMEOUT_SECONDS=90
JARVIS_FLEET_MINI_NAME=Mac Mini
JARVIS_FLEET_MINI_LAN_HOST=127.0.0.1
JARVIS_FLEET_MACBOOK_NAME=MacBook
JARVIS_FLEET_MACBOOK_LAN_HOST=
JARVIS_FLEET_PC_NAME=Windows PC
JARVIS_FLEET_PC_LAN_HOST=
JARVIS_FLEET_PC_MAC=
JARVIS_FLEET_WOL_BROADCAST=255.255.255.255
JARVIS_FLEET_WOL_PORT=9
